# 对外映射端口；正式公网建议只让反向代理访问它。
WORDPAPER_PORT=8770

# 正式域名必须写完整 HTTPS origin，不要带末尾斜杠。
WORDPAPER_PUBLIC_ORIGIN=https://wordpaper.example.com

# 经本机受控 Nginx / Caddy HTTPS 反代时设为 1，使 Secure cookie 正确生效。
# 反代必须覆盖/追加 X-Forwarded-*，且 8770 只能绑定回环地址，不能让公网绕过反代直连。
TRUST_PROXY=1

# Google Cloud Console → OAuth 2.0 Client（Web application）
# 回调地址必须与控制台登记值逐字符一致。
WORDPAPER_GOOGLE_CLIENT_ID=
WORDPAPER_GOOGLE_CLIENT_SECRET=
WORDPAPER_GOOGLE_REDIRECT_URI=https://wordpaper.example.com/api/auth/google/callback

# 微信开放平台 → 网站应用 → 微信登录
# 网站应用与登录能力均需审核通过，回调域名需与提审域名一致。
WORDPAPER_WECHAT_APP_ID=
WORDPAPER_WECHAT_APP_SECRET=
WORDPAPER_WECHAT_REDIRECT_URI=https://wordpaper.example.com/api/auth/wechat/callback

# 邮箱注册验证码通过 Resend 发送。FROM 地址必须属于已在 Resend 验证的域名。
WORDPAPER_RESEND_API_KEY=
WORDPAPER_EMAIL_FROM=WordPaper <login@wordpaper.example.com>
